---
import BaseWeb from "../layouts/BaseWeb.astro";

export const prerender = true;
---

<BaseWeb title="Internal manager">
    <nav class="flex flex-col items-center justify-center mx-auto md:h-screen lg:py-0">
        <section class="w-full my-12 p-4 mb-4 border rounded-lg shadow-sm border-gray-700 sm:p-6 bg-gray-800 sm:max-w-md xl:p-0">
            <div class="flex flex-col gap-4 p-8">
                <a
                    href="/reminder"
                    class="text-white text-center font-bold bg-blue-600 hover:bg-blue-700 focus:ring-blue-800 focus:ring-4 py-2 px-4 rounded-lg"
                >
                    REMINDERS
                </a>
                <a
                    href="/file"
                    class="text-white text-center font-bold bg-blue-600 hover:bg-blue-700 focus:ring-blue-800 focus:ring-4 py-2 px-4 rounded-lg"
                >
                    FILES
                </a>
            </div>
        </section>
    </nav>
</BaseWeb>
